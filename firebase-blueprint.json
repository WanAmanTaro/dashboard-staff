{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Akaun pengguna sistem yang dipautkan kepada Firebase Authentication UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 160 },
        "staffId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "role": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "isAdmin": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "active", "suspended", "inactive"] },
        "centerId": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "emailVerified": { "type": "boolean" },
        "providers": { "type": "array" },
        "invitationId": { "type": "string", "maxLength": 128 },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "displayName", "role", "isAdmin", "status", "centerId", "departmentId", "staffId", "emailVerified", "providers", "invitationId", "createdAt", "updatedAt", "createdBy", "updatedBy"]
    },
    "UserInvitation": {
      "title": "UserInvitation",
      "description": "Pra-pendaftaran akaun oleh Admin sebelum log masuk pertama pegawai.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 160 },
        "staffId": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "isAdmin": { "type": "boolean" },
        "centerId": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["invited", "claimed", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "email", "fullName", "staffId", "role", "isAdmin", "centerId", "departmentId", "status", "createdAt", "updatedAt", "createdBy", "updatedBy"]
    },

      "required": ["id", "staffId", "uid", "fullName", "officialEmail", "position", "grade", "scheme", "isLecturer", "centerId", "centerName", "departmentId", "departmentName", "highestQualification", "primaryExpertise", "completionPercent", "hasPhoto", "certificateCount", "publicationCount", "status", "createdAt", "updatedAt", "createdBy", "updatedBy"]
    },

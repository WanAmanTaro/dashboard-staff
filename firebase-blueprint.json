        "unit": { "type": "string", "maxLength": 120 },
        "orgPosition": { "type": "string", "maxLength": 120 },
        "headOfCenter": { "type": "string", "maxLength": 160 },
        "headOfDepartment": { "type": "string", "maxLength": 160 },

      allow update: if isVerified() && isValidId(compId) && isValidCompetency(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id && incoming().staffId == existing().staffId
        && canUpdateOwnedStaffRecord();
      allow delete: if isAdmin() && isValidId(compId);

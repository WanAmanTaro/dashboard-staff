      allow create: if isVerified() && isValidId(photoId) && isValidProfilePhoto(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == photoId
        && canCreateOwnedStaffRecord(photoId, incoming());
      allow update: if isVerified() && isValidId(photoId) && isValidProfilePhoto(incoming()) && hasUpdatedTimestamps(incoming())
        && incoming().id == existing().id
        && incoming().staffId == existing().staffId
        && incoming().originalDriveFileId == existing().originalDriveFileId
        && incoming().originalFileName == existing().originalFileName
        && incoming().aspectRatio == existing().aspectRatio
        && incoming().mimeType == existing().mimeType
        && incoming().fileSize == existing().fileSize
        && canUpdateOwnedStaffRecord();
      allow delete: if isAdmin() && isValidId(photoId);

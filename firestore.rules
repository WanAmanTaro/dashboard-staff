    // 12. drive_settings
    match /drive_settings/{settingId} {
      allow get: if isActiveUser() && isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(settingId) && isValidDriveSetting(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == settingId;
      allow update: if isAdmin() && isValidId(settingId) && isValidDriveSetting(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id;
      allow delete: if false;
    }

    // 13. audit_logs (Immutable security log)
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(logId) && isValidAuditLog(incoming()) && incoming().id == logId && (isBootstrapAdmin() || hasUserDoc());
      allow update: if false;
      allow delete: if false;
    }

    // 14. generated_profiles
    match /generated_profiles/{genId} {
      allow get: if isValidId(genId) && (
        (resource == null && isAdmin())
        || (resource != null && canReadScopedRecord(resource.data))
      );
      allow list: if isAdmin()
        || (isActiveUser() && (
          resource.data.uid == request.auth.uid
          || (userHasAnyStaffId() && resource.data.staffId == userDoc().staffId)
          || userCenterIdMatches(resource.data.centerId)
          || userDepartmentIdMatches(resource.data.departmentId)
        ));
      allow create: if isVerified() && isValidId(genId) && isValidGeneratedProfile(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == genId && (
        isAdmin() || (isActiveUser() && incoming().uid == request.auth.uid)
      );
      allow update: if isAdmin() && isValidId(genId) && isValidGeneratedProfile(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(genId);
    }

    // 15. system_settings
    match /system_settings/{settingId} {
      allow get: if isActiveUser() && isValidId(settingId);
      allow list: if isActiveUser();
      allow create: if isAdmin() && isValidId(settingId) && isValidSystemSetting(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == settingId;
      allow update: if isAdmin() && isValidId(settingId) && isValidSystemSetting(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id;
      allow delete: if false;
    }

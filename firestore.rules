      allow delete: if isVerified() && isValidId(pubId) && (isAdmin() || (isActiveUser() && (existing().uid == request.auth.uid || (existing().uid == '' && userHasAnyStaffId() && existing().staffId == userDoc().staffId))));
    }

    // 10. certificates
    match /certificates/{certId} {
      allow get: if isValidId(certId) && (
        (resource == null && isAdmin())
        || (resource != null && canReadScopedRecord(resource.data))
      );
      allow list: if isAdmin()
        || (isActiveUser() && (
          resource.data.uid == request.auth.uid
          || (userHasAnyStaffId() && resource.data.staffId == userDoc().staffId)

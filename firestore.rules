      allow create: if isVerified() && isValidId(pubId) && isValidPublication(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == pubId
        && canCreateOwnedStaffRecord(incoming().staffId, incoming());
      allow update: if isVerified() && isValidId(pubId) && isValidPublication(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id && incoming().staffId == existing().staffId

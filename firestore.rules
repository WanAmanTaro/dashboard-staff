        && canUpdateOwnedStaffRecord();
      allow delete: if isVerified() && isValidId(certId) && (isAdmin() || (isActiveUser() && (existing().uid == request.auth.uid || (existing().uid == '' && userHasAnyStaffId() && existing().staffId == userDoc().staffId))));

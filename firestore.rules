    // 8b. iab_competencies
    match /iab_competencies/{compId} {
      allow get: if isValidId(compId) && (
        (resource == null && canReadMissingDirectoryDocForStaff(compId))
        || (resource != null && canReadDirectoryOrScopedRecord(resource.data))

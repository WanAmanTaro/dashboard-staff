rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // GLOBAL HARDENED PRIMITIVES (Phase 3)
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'iab-1248@moe-dl.edu.my';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function userDoc() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isUserDataActive(u) {
      return 'status' in u && u.status == 'active';
    }

    function isUserDataAdmin(u) {
      return isUserDataActive(u) && (('isAdmin' in u && u.isAdmin == true) || ('role' in u && u.role == 'L0'));
    }

    function isActiveUser() {
      return isVerified()
        && hasUserDoc()
        && isUserDataActive(userDoc());
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerified() && hasUserDoc() && isUserDataAdmin(userDoc()));
    }

    function isL3OrL4() {
      return isActiveUser()
        && 'role' in userDoc()
        && (userDoc().role == 'L3' || userDoc().role == 'L4');
    }

    function hasUserStaffId(targetStaffId) {
      return targetStaffId != ''
        && 'staffId' in userDoc()
        && userDoc().staffId == targetStaffId;
    }

    function userHasAnyStaffId() {
      return 'staffId' in userDoc() && userDoc().staffId is string && userDoc().staffId != '';
    }

    function userCenterIdMatches(cid) {
      return 'role' in userDoc()
        && userDoc().role == 'L1'
        && 'centerId' in userDoc()
        && userDoc().centerId is string
        && userDoc().centerId != ''
        && cid == userDoc().centerId;
    }

    function userDepartmentIdMatches(did) {
      return 'role' in userDoc()
        && userDoc().role == 'L2'
        && 'departmentId' in userDoc()
        && userDoc().departmentId is string
        && userDoc().departmentId != ''
        && did == userDoc().departmentId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 160));
    }

    function isValidNumberRange(val, minInt, maxInt, minFloat, maxFloat) {
      return (val is int && val >= minInt && val <= maxInt)
        || (val is float && val >= minFloat && val <= maxFloat);
    }

    function isValidIabTeachingEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'moduleOrField', 'teachingType', 'years'])
        && 'id' in entry && entry.id is string && entry.id.size() >= 1 && entry.id.size() <= 64
        && 'moduleOrField' in entry && entry.moduleOrField is string && entry.moduleOrField.size() >= 1 && entry.moduleOrField.size() <= 400
        && 'teachingType' in entry && entry.teachingType is string && entry.teachingType.size() <= 100
        && 'years' in entry && isValidNumberRange(entry.years, 0, 60, 0.0, 60.0);
    }

    function isValidSchoolTeachingEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'subject', 'years'])
        && 'id' in entry && entry.id is string && entry.id.size() >= 1 && entry.id.size() <= 64
        && 'subject' in entry && entry.subject is string && entry.subject.size() >= 1 && entry.subject.size() <= 400
        && 'years' in entry && isValidNumberRange(entry.years, 0, 60, 0.0, 60.0);
    }

    function isValidExternalTeachingEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'institution', 'moduleOrField', 'teachingType', 'years'])
        && 'id' in entry && entry.id is string && entry.id.size() >= 1 && entry.id.size() <= 64
        && 'institution' in entry && entry.institution is string && entry.institution.size() >= 1 && entry.institution.size() <= 400
        && 'moduleOrField' in entry && entry.moduleOrField is string && entry.moduleOrField.size() >= 1 && entry.moduleOrField.size() <= 400
        && 'teachingType' in entry && entry.teachingType is string && entry.teachingType.size() <= 100
        && 'years' in entry && isValidNumberRange(entry.years, 0, 60, 0.0, 60.0);
    }

    function isServerTimestampWindow(ts) {
      return ts is timestamp
        && ts >= request.time - duration.value(10, 's')
        && ts <= request.time + duration.value(10, 's');
    }

    function hasCreatedTimestamps(data) {
      return (data.createdAt == request.time && data.updatedAt == request.time)
        || (isServerTimestampWindow(data.createdAt) && isServerTimestampWindow(data.updatedAt));
    }

    function hasUpdatedTimestamps(data) {
      return (data.createdAt == existing().createdAt || !('createdAt' in data.diff(existing()).affectedKeys()))
        && (data.updatedAt == request.time || isServerTimestampWindow(data.updatedAt));
    }

    function canReadScopedRecord(data) {
      return isAdmin()
        || (isActiveUser() && (
          data.uid == request.auth.uid
          || (userHasAnyStaffId() && data.staffId == userDoc().staffId)
          || userCenterIdMatches(data.centerId)
          || userDepartmentIdMatches(data.departmentId)
        ));
    }

    function canReadDirectoryOrScopedRecord(data) {
      return canReadScopedRecord(data)
        || (isL3OrL4() && data.status == 'active');
    }

    function canUserDataReadMissingStaff(u, staffId) {
      return isUserDataActive(u) && (
        isUserDataAdmin(u)
        || (staffId != '' && 'staffId' in u && u.staffId == staffId)
      );
    }

    function canReadMissingOwnOrAdmin(staffId) {
      return isBootstrapAdmin()
        || (isVerified() && hasUserDoc() && canUserDataReadMissingStaff(userDoc(), staffId));
    }

    function canReadMissingScopedDocForStaff(staffId) {
      return canReadMissingOwnOrAdmin(staffId)
        || (isActiveUser()
            && exists(/databases/$(database)/documents/staff_profiles/$(staffId))
            && canReadScopedRecord(get(/databases/$(database)/documents/staff_profiles/$(staffId)).data));
    }

    function canReadMissingDirectoryDocForStaff(staffId) {
      return canReadMissingOwnOrAdmin(staffId)
        || (isActiveUser()
            && exists(/databases/$(database)/documents/staff_profiles/$(staffId))
            && canReadDirectoryOrScopedRecord(get(/databases/$(database)/documents/staff_profiles/$(staffId)).data));
    }

    function canUserDataCreateOwnedStaffRecord(u, targetStaffId, data) {
      return isUserDataActive(u) && (
        isUserDataAdmin(u)
        || (
          targetStaffId != ''
          && 'staffId' in u
          && u.staffId == targetStaffId
          && data.uid == request.auth.uid
          && data.staffId == targetStaffId
          && data.createdBy == request.auth.uid
          && data.updatedBy == request.auth.uid
        )
      );
    }

    function canCreateOwnedStaffRecord(targetStaffId, data) {
      return isBootstrapAdmin()
        || (isVerified() && hasUserDoc() && canUserDataCreateOwnedStaffRecord(userDoc(), targetStaffId, data));
    }

    function canUserDataUpdateOwnedStaffRecord(u) {
      return isUserDataActive(u) && (
        isUserDataAdmin(u)
        || (
          existing().uid == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().createdBy == existing().createdBy
          && incoming().updatedBy == request.auth.uid
        )
        || (
          'staffId' in u
          && u.staffId is string
          && u.staffId != ''
          && existing().staffId == u.staffId
          && (incoming().uid == request.auth.uid || incoming().uid == existing().uid)
          && incoming().createdBy == existing().createdBy
          && incoming().updatedBy == request.auth.uid
        )
      );
    }

    function canUpdateOwnedStaffRecord() {
      return isBootstrapAdmin()
        || (isVerified() && hasUserDoc() && canUserDataUpdateOwnedStaffRecord(userDoc()));
    }

    // =========================================================
    // VALIDATION BLUEPRINTS (Pillar 2: Anti-Update-Gap)
    // =========================================================
    function isValidUserAccount(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'isAdmin', 'status',
        'centerId', 'departmentId', 'staffId', 'emailVerified',
        'providers', 'invitationId', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'isAdmin', 'status',
        'centerId', 'departmentId', 'staffId', 'emailVerified',
        'providers', 'invitationId', 'lastLoginAt', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.uid)
      && isValidString(data.email, 3, 200)
      && isValidString(data.displayName, 1, 160)
      && data.role in ['L0', 'L1', 'L2', 'L3', 'L4', 'L5']
      && data.isAdmin is bool
      && data.status in ['pending', 'active', 'suspended', 'inactive']
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.staffId, 0, 64)
      && data.emailVerified is bool
      && isValidStringList(data.providers, 10)
      && isValidString(data.invitationId, 0, 128)
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidInvitation(data) {
      return data.keys().hasAll([
        'id', 'email', 'fullName', 'staffId', 'role', 'isAdmin',
        'centerId', 'departmentId', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'email', 'fullName', 'staffId', 'role', 'isAdmin',
        'centerId', 'departmentId', 'status', 'claimedByUid', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidString(data.email, 3, 200)
      && isValidString(data.fullName, 1, 160)
      && isValidId(data.staffId)
      && data.role in ['L0', 'L1', 'L2', 'L3', 'L4', 'L5']
      && data.isAdmin is bool
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.status in ['invited', 'claimed', 'revoked']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidStaffProfile(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'fullName', 'officialEmail', 'position', 'grade', 'scheme',
        'isLecturer', 'centerId', 'centerName', 'departmentId', 'departmentName',
        'unit', 'orgPosition', 'headOfCenter', 'headOfDepartment',
        'highestQualification', 'primaryExpertise', 'secondaryExpertise',
        'digitalCompetencies', 'expertiseKeywords', 'completionPercent', 'missingSections',
        'hasPhoto', 'photoDisplayUrl', 'certificateCount', 'publicationCount',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'role', 'fullName', 'officialEmail', 'position', 'grade', 'kupGrade', 'scheme',
        'isLecturer', 'centerId', 'centerName', 'departmentId', 'departmentName',
        'unit', 'orgPosition', 'headOfCenter', 'headOfDepartment',
        'highestQualification', 'primaryExpertise', 'secondaryExpertise',
        'digitalCompetencies', 'expertiseKeywords', 'completionPercent', 'missingSections',
        'hasPhoto', 'photoDisplayUrl', 'certificateCount', 'publicationCount',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && data.id == data.staffId
      && isValidString(data.uid, 0, 128)
      && (!('role' in data) || data.role in ['', 'L0', 'L1', 'L2', 'L3', 'L4', 'L5'])
      && isValidString(data.fullName, 1, 160)
      && isValidString(data.officialEmail, 3, 200)
      && isValidString(data.position, 0, 120)
      && isValidString(data.grade, 0, 40)
      && (!('kupGrade' in data) || isValidString(data.kupGrade, 0, 40))
      && isValidString(data.scheme, 0, 80)
      && data.isLecturer is bool
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.centerName, 0, 160)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.departmentName, 0, 160)
      && isValidString(data.unit, 0, 120)
      && isValidString(data.orgPosition, 0, 120)
      && isValidString(data.headOfCenter, 0, 160)
      && isValidString(data.headOfDepartment, 0, 160)
      && isValidString(data.highestQualification, 0, 80)
      && isValidString(data.primaryExpertise, 0, 160)
      && isValidString(data.secondaryExpertise, 0, 160)
      && isValidStringList(data.digitalCompetencies, 60)
      && isValidStringList(data.expertiseKeywords, 30)
      && isValidNumberRange(data.completionPercent, 0, 100, 0.0, 100.0)
      && isValidStringList(data.missingSections, 12)
      && data.hasPhoto is bool
      && isValidString(data.photoDisplayUrl, 0, 500)
      && isValidNumberRange(data.certificateCount, 0, 500, 0.0, 500.0)
      && isValidNumberRange(data.publicationCount, 0, 500, 0.0, 500.0)
      && data.status in ['active', 'inactive', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidStaffPrivatePII(data) {
      return data.keys().hasAll([
        'staffId', 'uid', 'centerId', 'departmentId', 'phone', 'gender', 'icNumber',
        'altContact', 'appointmentDate', 'serviceStatus', 'yearsOfService',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'staffId', 'uid', 'centerId', 'departmentId', 'phone', 'gender', 'icNumber',
        'altContact', 'appointmentDate', 'serviceStatus', 'yearsOfService',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.phone, 0, 40)
      && isValidString(data.gender, 0, 30)
      && isValidString(data.icNumber, 0, 24)
      && isValidString(data.altContact, 0, 160)
      && isValidString(data.appointmentDate, 0, 32)
      && isValidString(data.serviceStatus, 0, 60)
      && isValidNumberRange(data.yearsOfService, 0, 80, 0.0, 80.0)
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidOrganization(data) {
      return data.keys().hasAll([
        'id', 'code', 'name', 'headName', 'headUid', 'location', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'code', 'name', 'headName', 'headUid', 'location', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidString(data.code, 1, 24)
      && isValidString(data.name, 1, 160)
      && isValidString(data.headName, 0, 160)
      && isValidString(data.headUid, 0, 128)
      && isValidString(data.location, 0, 120)
      && data.status in ['active', 'inactive']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidDepartment(data) {
      return data.keys().hasAll([
        'id', 'centerId', 'code', 'name', 'headName', 'headUid', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'centerId', 'code', 'name', 'headName', 'headUid', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.centerId)
      && isValidString(data.code, 1, 24)
      && isValidString(data.name, 1, 160)
      && isValidString(data.headName, 0, 160)
      && isValidString(data.headUid, 0, 128)
      && data.status in ['active', 'inactive']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidQualification(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'level', 'institution',
        'fieldOfStudy', 'graduationYear', 'notes', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'level', 'institution',
        'fieldOfStudy', 'graduationYear', 'notes', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.level in ['PhD', 'Sarjana', 'Sarjana Muda', 'Diploma', 'Kelayakan Lain']
      && isValidString(data.institution, 1, 200)
      && isValidString(data.fieldOfStudy, 1, 200)
      && isValidString(data.graduationYear, 1, 10)
      && isValidString(data.notes, 0, 500)
      && data.status in ['active', 'archived']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidExpertise(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'primaryExpertise', 'secondaryExpertise',
        'specializations', 'researchAreas', 'teachingAreas', 'trainingAreas', 'keywords',
        'teachingExp', 'managementExp', 'facilitatorExp', 'speakerExp', 'coachExp',
        'projectExp', 'professionalExp', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'primaryExpertise', 'secondaryExpertise',
        'specializations', 'researchAreas', 'teachingAreas', 'trainingAreas', 'keywords',
        'teachingExp', 'managementExp', 'facilitatorExp', 'speakerExp', 'coachExp',
        'projectExp', 'professionalExp', 'iabTeachingList', 'schoolTeachingList', 'externalTeachingList',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.primaryExpertise, 0, 160)
      && isValidString(data.secondaryExpertise, 0, 160)
      && isValidStringList(data.specializations, 20)
      && isValidStringList(data.researchAreas, 20)
      && isValidStringList(data.teachingAreas, 20)
      && isValidStringList(data.trainingAreas, 20)
      && isValidStringList(data.keywords, 30)
      && isValidString(data.teachingExp, 0, 1500)
      && isValidString(data.managementExp, 0, 1500)
      && isValidString(data.facilitatorExp, 0, 1500)
      && isValidString(data.speakerExp, 0, 1500)
      && isValidString(data.coachExp, 0, 1500)
      && isValidString(data.projectExp, 0, 1500)
      && isValidString(data.professionalExp, 0, 1500)
      && (!('iabTeachingList' in data) || (
        data.iabTeachingList is list && data.iabTeachingList.size() <= 100
        && (data.iabTeachingList.size() == 0 || isValidIabTeachingEntry(data.iabTeachingList[0]))
      ))
      && (!('schoolTeachingList' in data) || (
        data.schoolTeachingList is list && data.schoolTeachingList.size() <= 100
        && (data.schoolTeachingList.size() == 0 || isValidSchoolTeachingEntry(data.schoolTeachingList[0]))
      ))
      && (!('externalTeachingList' in data) || (
        data.externalTeachingList is list && data.externalTeachingList.size() <= 100
        && (data.externalTeachingList.size() == 0 || isValidExternalTeachingEntry(data.externalTeachingList[0]))
      ))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidCompetency(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'items', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'items', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.items is list && data.items.size() <= 60
      && (data.items.size() == 0 || (
        data.items[0] is map
        && data.items[0].keys().hasOnly([
          'categoryId', 'categoryName', 'skillType', 'level', 'years', 'notes',
          'hasCertificate', 'certificateId', 'certificateTitle', 'certificateDriveFileId',
          'hasValidityPeriod', 'certificateStartDate', 'certificateEndDate', 'certificateValidityDuration'
        ])
        && data.items[0].categoryId is string && data.items[0].categoryId.size() <= 80
        && data.items[0].categoryName is string && data.items[0].categoryName.size() >= 1 && data.items[0].categoryName.size() <= 160
      ))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidIabCompetency(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'certifications', 'modules', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'certifications', 'modules', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.certifications is list && data.certifications.size() <= 20
      && (data.certifications.size() == 0 || (
        data.certifications[0] is map
        && data.certifications[0].keys().hasOnly(['key', 'label', 'status', 'passYear'])
        && data.certifications[0].key is string && data.certifications[0].key.size() <= 60
        && data.certifications[0].label is string && data.certifications[0].label.size() <= 120
        && data.certifications[0].status in ['Ada', 'Tiada']
        && data.certifications[0].passYear is string && data.certifications[0].passYear.size() <= 24
      ))
      && data.modules is list && data.modules.size() <= 100
      && (data.modules.size() == 0 || (
        data.modules[0] is map
        && data.modules[0].keys().hasOnly(['id', 'moduleName', 'year', 'contribution', 'activeStatus'])
        && data.modules[0].id is string && data.modules[0].id.size() <= 64
        && data.modules[0].moduleName is string && data.modules[0].moduleName.size() >= 1 && data.modules[0].moduleName.size() <= 160
        && data.modules[0].year is string && data.modules[0].year.size() <= 16
        && data.modules[0].contribution in ['KETUA PAKAR RUJUK (KPR)', 'PAKAR RUJUK UTAMA (PRU)', 'Ahli']
        && data.modules[0].activeStatus in ['Aktif', 'Tidak Aktif']
      ))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidPublication(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'type', 'title',
        'publisherOrVenue', 'year', 'url', 'description', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'type', 'title',
        'publisherOrVenue', 'year', 'achievement', 'url', 'description', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.type in ['Buku', 'Artikel Jurnal', 'Prosiding', 'Modul', 'Sumber Rujukan', 'Penyelidikan', 'Inovasi', 'Pengiktirafan']
      && isValidString(data.title, 1, 240)
      && isValidString(data.publisherOrVenue, 0, 200)
      && isValidString(data.year, 1, 10)
      && (!('achievement' in data) || isValidString(data.achievement, 0, 200))
      && isValidString(data.url, 0, 500)
      && isValidString(data.description, 0, 1000)
      && data.status in ['active', 'archived']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidCertificate(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'title', 'category',
        'certificateDate', 'driveFileId', 'driveFolderId', 'fileName', 'mimeType',
        'fileSize', 'uploadedBy', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'title', 'category',
        'certificateDate', 'driveFileId', 'driveFolderId', 'fileName', 'mimeType',
        'fileSize', 'uploadedBy', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 1, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.title, 1, 200)
      && data.category in ['Sijil Akademik', 'Sijil Profesional', 'Sijil Kompetensi', 'Sijil Latihan', 'Sijil Pengiktirafan', 'Dokumen Lain']
      && isValidString(data.certificateDate, 0, 32)
      && isValidString(data.driveFileId, 1, 200)
      && isValidString(data.driveFolderId, 0, 200)
      && isValidString(data.fileName, 1, 255)
      && isValidString(data.mimeType, 1, 120)
      && isValidNumberRange(data.fileSize, 0, 52428800, 0.0, 52428800.0)
      && isValidString(data.uploadedBy, 1, 128)
      && data.status in ['active', 'replaced', 'deleted', 'orphan_pending']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidProfilePhoto(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'originalDriveFileId',
        'displayDriveFileId', 'originalFileName', 'displayFileName', 'cropX', 'cropY',
        'zoom', 'alignX', 'alignY', 'aspectRatio', 'mimeType', 'fileSize', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'originalDriveFileId',
        'displayDriveFileId', 'originalFileName', 'displayFileName', 'cropX', 'cropY',
        'zoom', 'alignX', 'alignY', 'aspectRatio', 'mimeType', 'fileSize', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 1, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && isValidString(data.originalDriveFileId, 1, 200)
      && isValidString(data.displayDriveFileId, 1, 200)
      && isValidString(data.originalFileName, 1, 255)
      && isValidString(data.displayFileName, 1, 255)
      && isValidNumberRange(data.cropX, -10000, 10000, -10000.0, 10000.0)
      && isValidNumberRange(data.cropY, -10000, 10000, -10000.0, 10000.0)
      && isValidNumberRange(data.zoom, 1, 5, 0.5, 5.0)
      && data.alignX in ['left', 'center', 'right']
      && data.alignY in ['top', 'center', 'bottom']
      && data.aspectRatio == '1:1'
      && isValidString(data.mimeType, 1, 64)
      && isValidNumberRange(data.fileSize, 0, 20971520, 0.0, 20971520.0)
      && data.status in ['active', 'replaced', 'deleted']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidDriveSetting(data) {
      return data.keys().hasAll([
        'id', 'status', 'connectedEmail', 'rootFolderId', 'folderIds',
        'lastConnectedAt', 'lastUploadAt', 'uploadedDocumentsCount', 'uploadedPhotosCount',
        'maxPhotoSizeMb', 'maxCertSizeMb', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'status', 'connectedEmail', 'rootFolderId', 'folderIds',
        'lastConnectedAt', 'lastUploadAt', 'uploadedDocumentsCount', 'uploadedPhotosCount',
        'maxPhotoSizeMb', 'maxCertSizeMb', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && data.status in ['connected', 'disconnected', 'error', 'pending_configuration']
      && isValidString(data.connectedEmail, 0, 200)
      && isValidString(data.rootFolderId, 0, 200)
      && data.folderIds is map
      && isValidString(data.lastConnectedAt, 0, 64)
      && isValidString(data.lastUploadAt, 0, 64)
      && isValidNumberRange(data.uploadedDocumentsCount, 0, 1000000, 0.0, 1000000.0)
      && isValidNumberRange(data.uploadedPhotosCount, 0, 1000000, 0.0, 1000000.0)
      && isValidNumberRange(data.maxPhotoSizeMb, 1, 50, 1.0, 50.0)
      && isValidNumberRange(data.maxCertSizeMb, 1, 100, 1.0, 100.0)
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'id', 'actorUid', 'actorEmail', 'staffId', 'actionType',
        'targetType', 'targetId', 'outcome', 'details', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'actorUid', 'actorEmail', 'staffId', 'actionType',
        'targetType', 'targetId', 'outcome', 'details', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.actorUid)
      && data.actorUid == request.auth.uid
      && isValidString(data.actorEmail, 1, 200)
      && isValidString(data.staffId, 0, 64)
      && isValidString(data.actionType, 1, 80)
      && isValidString(data.targetType, 1, 80)
      && isValidString(data.targetId, 1, 128)
      && data.outcome in ['success', 'failure']
      && isValidString(data.details, 0, 500)
      && (data.createdAt == request.time || isServerTimestampWindow(data.createdAt));
    }

    function isValidGeneratedProfile(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'templateType',
        'dataVersion', 'driveFileId', 'fileName', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId', 'templateType',
        'dataVersion', 'driveFileId', 'fileName', 'status',
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.templateType in ['ringkas', 'lengkap']
      && isValidString(data.dataVersion, 1, 64)
      && isValidString(data.driveFileId, 0, 200)
      && isValidString(data.fileName, 1, 255)
      && data.status in ['generated', 'stored_in_drive']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidSystemSetting(data) {
      return data.keys().hasAll([
        'id', 'systemName', 'institutionName', 'expertiseCategories', 'competencyCategories',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'systemName', 'institutionName', 'expertiseCategories', 'competencyCategories',
        'applicationSkillCategories', 'knowledgeSkillCategories',
        'institutionCategories', 'publicationYears', 'iabModules',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidString(data.systemName, 1, 160)
      && isValidString(data.institutionName, 1, 160)
      && isValidStringList(data.expertiseCategories, 60)
      && isValidStringList(data.competencyCategories, 120)
      && (!('applicationSkillCategories' in data) || isValidStringList(data.applicationSkillCategories, 60))
      && (!('knowledgeSkillCategories' in data) || isValidStringList(data.knowledgeSkillCategories, 60))
      && (!('institutionCategories' in data) || isValidStringList(data.institutionCategories, 120))
      && (!('publicationYears' in data) || isValidStringList(data.publicationYears, 40))
      && (!('iabModules' in data) || isValidStringList(data.iabModules, 100))
      && data.status == 'active'
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidStaffFunctions(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'trainings', 'programManagements', 'consultations',
        'npqelSupervisions', 'programEvaluations', 'thinkTankEntries',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'trainings', 'programManagements', 'consultations',
        'npqelSupervisions', 'programEvaluations', 'thinkTankEntries',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && data.id == data.staffId
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.trainings is list && data.trainings.size() <= 100
      && (data.trainings.size() == 0 || (
        data.trainings[0] is map
        && data.trainings[0].keys().hasOnly(['id', 'moduleName', 'role', 'year'])
        && data.trainings[0].id is string && data.trainings[0].id.size() <= 64
        && data.trainings[0].moduleName is string && data.trainings[0].moduleName.size() >= 1 && data.trainings[0].moduleName.size() <= 200
        && data.trainings[0].role is string && data.trainings[0].role.size() <= 80
        && data.trainings[0].year is string && data.trainings[0].year.size() <= 16
      ))
      && data.programManagements is list && data.programManagements.size() <= 100
      && (data.programManagements.size() == 0 || (
        data.programManagements[0] is map
        && data.programManagements[0].keys().hasOnly(['id', 'programName', 'centerId', 'centerName', 'departmentId', 'departmentName', 'role', 'year'])
        && data.programManagements[0].id is string && data.programManagements[0].id.size() <= 64
        && data.programManagements[0].programName is string && data.programManagements[0].programName.size() >= 1 && data.programManagements[0].programName.size() <= 200
      ))
      && data.consultations is list && data.consultations.size() <= 100
      && (data.consultations.size() == 0 || (
        data.consultations[0] is map
        && data.consultations[0].keys().hasOnly(['id', 'title', 'organization', 'consultationType', 'role', 'year', 'impact'])
        && data.consultations[0].id is string && data.consultations[0].id.size() <= 64
        && data.consultations[0].title is string && data.consultations[0].title.size() >= 1 && data.consultations[0].title.size() <= 240
      ))
      && data.npqelSupervisions is list && data.npqelSupervisions.size() <= 100
      && (data.npqelSupervisions.size() == 0 || (
        data.npqelSupervisions[0] is map
        && data.npqelSupervisions[0].keys().hasOnly(['id', 'participantName', 'participantClass', 'year'])
        && data.npqelSupervisions[0].id is string && data.npqelSupervisions[0].id.size() <= 64
        && data.npqelSupervisions[0].participantName is string && data.npqelSupervisions[0].participantName.size() >= 1 && data.npqelSupervisions[0].participantName.size() <= 160
      ))
      && data.programEvaluations is list && data.programEvaluations.size() <= 100
      && (data.programEvaluations.size() == 0 || (
        data.programEvaluations[0] is map
        && data.programEvaluations[0].keys().hasOnly(['id', 'programName', 'centerName', 'role', 'year', 'score'])
        && data.programEvaluations[0].id is string && data.programEvaluations[0].id.size() <= 64
        && data.programEvaluations[0].programName is string && data.programEvaluations[0].programName.size() >= 1 && data.programEvaluations[0].programName.size() <= 400
      ))
      && data.thinkTankEntries is list && data.thinkTankEntries.size() <= 100
      && (data.thinkTankEntries.size() == 0 || (
        data.thinkTankEntries[0] is map
        && data.thinkTankEntries[0].keys().hasOnly(['id', 'committeeName', 'level', 'role', 'focusArea', 'year', 'activeStatus'])
        && data.thinkTankEntries[0].id is string && data.thinkTankEntries[0].id.size() <= 64
        && data.thinkTankEntries[0].committeeName is string && data.thinkTankEntries[0].committeeName.size() >= 1 && data.thinkTankEntries[0].committeeName.size() <= 240
      ))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidStaffAchievements(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'apcAwards', 'innovations', 'researchOutputs', 'otherAchievements',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'apcAwards', 'innovations', 'researchOutputs', 'otherAchievements',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && data.id == data.staffId
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.apcAwards is list && data.apcAwards.size() <= 100
      && (data.apcAwards.size() == 0 || (
        data.apcAwards[0] is map
        && data.apcAwards[0].keys().hasOnly(['id', 'awardName', 'year', 'certificateId', 'certificateTitle', 'certificateDriveFileId', 'fileName'])
        && data.apcAwards[0].id is string && data.apcAwards[0].id.size() <= 64
        && data.apcAwards[0].awardName is string && data.apcAwards[0].awardName.size() >= 1 && data.apcAwards[0].awardName.size() <= 160
        && data.apcAwards[0].year is string && data.apcAwards[0].year.size() <= 16
      ))
      && data.innovations is list && data.innovations.size() <= 100
      && (data.innovations.size() == 0 || (
        data.innovations[0] is map
        && data.innovations[0].keys().hasOnly(['id', 'projectName', 'innovationType', 'role', 'level', 'recognition', 'year', 'evidenceUrl', 'evidenceDriveFileId', 'evidenceFileName'])
        && data.innovations[0].id is string && data.innovations[0].id.size() <= 64
        && data.innovations[0].projectName is string && data.innovations[0].projectName.size() >= 1 && data.innovations[0].projectName.size() <= 240
      ))
      && data.researchOutputs is list && data.researchOutputs.size() <= 100
      && (data.researchOutputs.size() == 0 || (
        data.researchOutputs[0] is map
        && data.researchOutputs[0].keys().hasOnly(['id', 'outputType', 'title', 'role', 'publisherOrJournal', 'identifier', 'year', 'indexing', 'field', 'url', 'evidenceDriveFileId', 'evidenceFileName'])
        && data.researchOutputs[0].id is string && data.researchOutputs[0].id.size() <= 64
        && data.researchOutputs[0].title is string && data.researchOutputs[0].title.size() >= 1 && data.researchOutputs[0].title.size() <= 300
      ))
      && data.otherAchievements is list && data.otherAchievements.size() <= 100
      && (data.otherAchievements.size() == 0 || (
        data.otherAchievements[0] is map
        && data.otherAchievements[0].keys().hasOnly(['id', 'title', 'achievementType', 'description', 'role', 'organization', 'level', 'dateOrYear', 'impact', 'evidenceUrl', 'evidenceDriveFileId', 'evidenceFileName', 'notes'])
        && data.otherAchievements[0].id is string && data.otherAchievements[0].id.size() <= 64
        && data.otherAchievements[0].title is string && data.otherAchievements[0].title.size() >= 1 && data.otherAchievements[0].title.size() <= 240
      ))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    function isValidTeachingExperience(data) {
      return data.keys().hasAll([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'iabTeachingList', 'schoolTeachingList', 'externalTeachingList',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'staffId', 'uid', 'centerId', 'departmentId',
        'iabTeachingList', 'schoolTeachingList', 'externalTeachingList',
        'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidId(data.staffId)
      && data.id == data.staffId
      && isValidString(data.uid, 0, 128)
      && isValidString(data.centerId, 0, 64)
      && isValidString(data.departmentId, 0, 64)
      && data.iabTeachingList is list && data.iabTeachingList.size() <= 100
      && (data.iabTeachingList.size() == 0 || isValidIabTeachingEntry(data.iabTeachingList[0]))
      && data.schoolTeachingList is list && data.schoolTeachingList.size() <= 100
      && (data.schoolTeachingList.size() == 0 || isValidSchoolTeachingEntry(data.schoolTeachingList[0]))
      && data.externalTeachingList is list && data.externalTeachingList.size() <= 100
      && (data.externalTeachingList.size() == 0 || isValidExternalTeachingEntry(data.externalTeachingList[0]))
      && data.status in ['active', 'draft']
      && isValidString(data.createdBy, 1, 128)
      && isValidString(data.updatedBy, 1, 128);
    }

    // =========================================================
    // COLLECTION MATCH BLOCKS
    // =========================================================

    // 1. users
    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(uid) && isValidUserAccount(incoming())
        && hasCreatedTimestamps(incoming())
        && (
          (isBootstrapAdmin() && request.auth.uid == uid && incoming().uid == uid && incoming().isAdmin == true && incoming().status == 'active')
          || isAdmin()
          || (
            isVerified() && request.auth.uid == uid && incoming().uid == uid
            && incoming().email == request.auth.token.email
            && incoming().invitationId != ''
            && exists(/databases/$(database)/documents/invitations/$(incoming().invitationId))
            && get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.status == 'invited'
            && get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.email == request.auth.token.email
            && incoming().role == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.role
            && incoming().isAdmin == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.isAdmin
            && incoming().centerId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.centerId
            && incoming().departmentId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.departmentId
            && incoming().staffId == get(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.staffId
            && incoming().status == 'active'
          )
          || (
            isVerified() && request.auth.uid == uid && incoming().uid == uid
            && incoming().email == request.auth.token.email
            && incoming().status == 'pending'
            && incoming().isAdmin == false
            && incoming().role == 'L5'
            && incoming().invitationId == ''
          )
        );

      allow update: if isSignedIn() && isValidId(uid) && isValidUserAccount(incoming())
        && hasUpdatedTimestamps(incoming())
        && incoming().uid == existing().uid
        && (
          (isAdmin() && !(request.auth.uid == uid && existing().isAdmin == false && incoming().isAdmin == true))
          || (
            isVerified() && request.auth.uid == uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().isAdmin == existing().isAdmin
            && incoming().status == existing().status
            && incoming().centerId == existing().centerId
            && incoming().departmentId == existing().departmentId
            && incoming().staffId == existing().staffId
            && incoming().invitationId == existing().invitationId
            && incoming().createdBy == existing().createdBy
            && incoming().updatedBy == request.auth.uid
          )
        );

      allow delete: if isAdmin() && isValidId(uid) && request.auth.uid != uid;
    }

    // 2. invitations
    match /invitations/{inviteId} {
      allow get: if isVerified() && isValidId(inviteId) && (isAdmin() || resource == null || resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(inviteId) && isValidInvitation(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == inviteId;
      allow update: if isVerified() && isValidId(inviteId) && isValidInvitation(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id && (
        isAdmin()
        || (
          existing().status == 'invited'
          && existing().email == request.auth.token.email
          && incoming().status == 'claimed'
          && incoming().claimedByUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'updatedAt', 'updatedBy'])
        )
      );
      allow delete: if isAdmin() && isValidId(inviteId);
    }

    // 3. staff_profiles + isolated PII subcollection
    match /staff_profiles/{staffId} {
      allow get: if isValidId(staffId) && (
        (resource == null && canReadMissingOwnOrAdmin(staffId))
        || (resource != null && canReadDirectoryOrScopedRecord(resource.data))
      );
      allow list: if isAdmin()
        || (isActiveUser() && (
          resource.data.uid == request.auth.uid
          || (userHasAnyStaffId() && resource.data.staffId == userDoc().staffId)
          || userCenterIdMatches(resource.data.centerId)
          || userDepartmentIdMatches(resource.data.departmentId)
          || (isL3OrL4() && resource.data.status == 'active')
        ));

      allow create: if isVerified() && isValidId(staffId) && isValidStaffProfile(incoming()) && hasCreatedTimestamps(incoming())
        && incoming().id == staffId
        && canCreateOwnedStaffRecord(staffId, incoming());

      allow update: if isVerified() && isValidId(staffId) && isValidStaffProfile(incoming()) && hasUpdatedTimestamps(incoming())
        && incoming().id == existing().id
        && incoming().staffId == existing().staffId
        && canUpdateOwnedStaffRecord();

      allow delete: if isAdmin() && isValidId(staffId);

      match /private/{docId} {
        allow get: if isValidId(staffId) && isValidId(docId) && (
          (resource == null && canReadMissingScopedDocForStaff(staffId))
          || (resource != null && canReadScopedRecord(resource.data))
        );
        allow list: if isAdmin()
          || (isActiveUser() && (
            resource.data.uid == request.auth.uid
            || (userHasAnyStaffId() && resource.data.staffId == userDoc().staffId)
            || userCenterIdMatches(resource.data.centerId)
            || userDepartmentIdMatches(resource.data.departmentId)
          ));
        allow create: if isVerified() && isValidId(staffId) && isValidId(docId) && isValidStaffPrivatePII(incoming()) && hasCreatedTimestamps(incoming())
          && incoming().staffId == staffId
          && canCreateOwnedStaffRecord(staffId, incoming());
        allow update: if isVerified() && isValidId(staffId) && isValidId(docId) && isValidStaffPrivatePII(incoming()) && hasUpdatedTimestamps(incoming())
          && incoming().staffId == existing().staffId
          && canUpdateOwnedStaffRecord();
        allow delete: if isAdmin() && isValidId(staffId) && isValidId(docId);
      }
    }

    // 4. organizations
    match /organizations/{centerId} {
      allow get: if isActiveUser() && isValidId(centerId);
      allow list: if isActiveUser();
      allow create: if isAdmin() && isValidId(centerId) && isValidOrganization(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == centerId;
      allow update: if isAdmin() && isValidId(centerId) && isValidOrganization(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(centerId);
    }

    // 5. departments
    match /departments/{departmentId} {
      allow get: if isActiveUser() && isValidId(departmentId);
      allow list: if isActiveUser();
      allow create: if isAdmin() && isValidId(departmentId) && isValidDepartment(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == departmentId && exists(/databases/$(database)/documents/organizations/$(incoming().centerId));
      allow update: if isAdmin() && isValidId(departmentId) && isValidDepartment(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(departmentId);
    }

    // 6. qualifications
    match /qualifications/{qualId} {
      allow get: if isValidId(qualId) && (
        (resource == null && isAdmin())
        || (resource != null && canReadDirectoryOrScopedRecord(resource.data))
      );
      allow list: if isAdmin()
        || (isActiveUser() && (
          resource.data.uid == request.auth.uid
          || (userHasAnyStaffId() && resource.data.staffId == userDoc().staffId)
          || userCenterIdMatches(resource.data.centerId)
          || userDepartmentIdMatches(resource.data.departmentId)
          || (isL3OrL4() && resource.data.status == 'active')
        ));
      allow create: if isVerified() && isValidId(qualId) && isValidQualification(incoming()) && hasCreatedTimestamps(incoming()) && incoming().id == qualId
        && canCreateOwnedStaffRecord(incoming().staffId, incoming());
      allow update: if isVerified() && isValidId(qualId) && isValidQualification(incoming()) && hasUpdatedTimestamps(incoming()) && incoming().id == existing().id && incoming().staffId == existing().staffId
        && canUpdateOwnedStaffRecord();
      allow delete: if isVerified() && isValidId(qualId) && (isAdmin() || (isActiveUser() && (existing().uid == request.auth.uid || (existing().uid == '' && userHasAnyStaffId() && existing().staffId == userDoc().staffId))));
